{UTF-8}
AOCoLUPpUA Annual Ongoing Cost of Land Use Policies per Unit Area[Land Use Policy] = 
                GET DIRECT CONSTANTS('InputData/land/AOCoLUPpUA/AOCoLUPpUA.csv', ',', 
                'B2*')
	~	$/acre
	~		|

BLAPE BAU LULUCF Anthropogenic Pollutant Emissions[Pollutant] := GET DIRECT DATA('InputData/land/BLAPE/BLAPE.csv'
                , ',', '1', 'B2')
	~	g pollutant
	~		|

CApULAbIFM CO2 Abated per Unit Land Area by Improved Forest Management = GET DIRECT CONSTANTS(
                'InputData/land/CApULAbIFM/CApULAbIFM.csv', ',', 'B2*')
	~	g pollutant/acre
	~		|

Cash Flow Entity : government,nonenergy industries,labor and consumers,foreign entities
        ,electricity suppliers,coal suppliers,natural gas and petroleum suppliers,biomass and biofuel suppliers
        ,other energy suppliers
	~	
	~		|

cash flow entity excluding energy suppliers : government,nonenergy industries,labor and consumers
        ,foreign entities
	~	
	~		|

Change in Forest Expenses by Entity[Cash Flow Entity] = ( SUM ( Cost of Implementing Land Use Policies[
             Land Use Policy!] ) + SUM ( Cost of Maintaining Area Previously Affected by Land Use Policies[
                  Land Use Policy!] ) ) * FoFObE Fraction of Forests Owned by Entity[
             Cash Flow Entity] 
	~	$
	~		|

Change in LULUCF Emissions[Pollutant] :EXCEPT: [CO2] = SUM ( CO2 Abated by Land Use Policy This Year[
             Land Use Policy!] ) * RPEpUACE Rebound Pollutant Emissions per Unit Avoided CO2 Emissions[
             Pollutant]  ~~|
Change in LULUCF Emissions[CO2] = - SUM ( CO2 Abated by Land Use Policy This Year[Land Use Policy!
             ] ) 
	~	g pollutant
	~		|

CiLVpUAAbP Change in Land Value per Unit Area Affected by Policy[Land Use Policy] = GET DIRECT CONSTANTS(
                'InputData/land/CiLVpUAAbP/CiLVpUAAbP.csv', ',', 'B2*')
	~	$/acre
	~		|

CO2 Abated by Improved Forest Management This Year = Land Area Newly Affected by Policy[
        land forest management] * One Year * CApULAbIFM CO2 Abated per Unit Land Area by Improved Forest Management
             
	~	g pollutant
	~		|

CO2 Abated by Land Use Policy This Year[Land Use Policy] :EXCEPT: [land forest management
] = Cumulative Total Land Area Affected by Policy[Land Use Policy] * CSpULApYbP CO2 Sequestered per Unit Land Area per Year by Policy[
             Land Use Policy]  ~~|
CO2 Abated by Land Use Policy This Year[land forest management] = CO2 Abated by Improved Forest Management This Year
        
	~	g pollutant
	~		|

Cost of Implementing Land Use Policies[Land Use Policy] = Land Area Newly Affected by Policy[
        Land Use Policy] * One Year * ICoLUPpUA Implementation Cost of Land Use Policies per Unit Area[
             Land Use Policy] 
	~	$
	~		|

Cost of Maintaining Area Previously Affected by Land Use Policies[Land Use Policy] = 
        Cumulative Total Land Area Affected by Policy[Land Use Policy] * AOCoLUPpUA Annual Ongoing Cost of Land Use Policies per Unit Area[
             Land Use Policy] 
	~	$
	~		|

CSpULApYbP CO2 Sequestered per Unit Land Area per Year by Policy[Land Use Policy] = GET DIRECT CONSTANTS(
                'InputData/land/CSpULApYbP/CSpULApYbP.csv', ',', 'B2*')
	~	g pollutant/acre
	~		|

Cumulative Change in Land Value from Land Use Policies[Land Use Policy] = Cumulative Total Land Area Affected by Policy[
        Land Use Policy] * CiLVpUAAbP Change in Land Value per Unit Area Affected by Policy[
             Land Use Policy] 
	~	$
	~		~	:SUPPLEMENTARY 
	|

Cumulative Total Land Area Affected by Policy[Land Use Policy] = Last Year Cumulative Total Land Area Affected by Policy[
        Land Use Policy] + Land Area Newly Affected by Policy[Land Use Policy] * One Year
                  
	~	acres
	~		|

FoFObE Fraction of Forests Owned by Entity[Cash Flow Entity] :EXCEPT: [cash flow entity excluding energy suppliers
] = 0 ~~|
FoFObE Fraction of Forests Owned by Entity[cash flow entity excluding energy suppliers
] = GET DIRECT CONSTANTS('InputData/land/FoFObE/FoFObE.csv', ',', 'B2*')
	~	Dmnl
	~		|

Fraction of Afforestation and Reforestation Achieved This Year = Fraction of Afforestation and Reforestation Achieved
        * Selected Policy Implementation Schedule[land afforestation and reforestation X
             ] 
	~	Dmnl
	~		|

Fraction of Avoided Deforestation Achieved This Year = Fraction of Avoided Deforestation Achieved
        * Selected Policy Implementation Schedule[land avoid deforestation X] 
	~	Dmnl
	~		|

Fraction of Forest Restoration Achieved This Year = Fraction of Forest Restoration Achieved
        * Selected Policy Implementation Schedule[land forest restoration X] 
	~	Dmnl
	~		|

Fraction of Forest Set Asides Achieved This Year = Fraction of Forest Set Asides Achieved
        * Selected Policy Implementation Schedule[land forest set asides X] 
	~	Dmnl
	~		|

Fraction of Improved Forest Management Achieved This Year = Fraction of Improved Forest Management Achieved
        * Selected Policy Implementation Schedule[land forest management X] 
	~	Dmnl
	~		|

Fraction of Land Use Policy Achieved This Year by Policy[land forest set asides] = Fraction of Forest Set Asides Achieved This Year
         ~~|
Fraction of Land Use Policy Achieved This Year by Policy[land afforestation and reforestation
] = Fraction of Afforestation and Reforestation Achieved This Year  ~~|
Fraction of Land Use Policy Achieved This Year by Policy[land forest management] = Fraction of Improved Forest Management Achieved This Year
         ~~|
Fraction of Land Use Policy Achieved This Year by Policy[land avoid deforestation] = 
        Fraction of Avoided Deforestation Achieved This Year  ~~|
Fraction of Land Use Policy Achieved This Year by Policy[land peatland restoration] = 
        Fraction of Peatland Restoration Achieved This Year  ~~|
Fraction of Land Use Policy Achieved This Year by Policy[land forest restoration] = Fraction of Forest Restoration Achieved This Year
        
	~	Dmnl
	~		|

Fraction of Peatland Restoration Achieved This Year = Fraction of Peatland Restoration Achieved
        * Selected Policy Implementation Schedule[land peatland restoration X] 
	~	Dmnl
	~		|

ICoLUPpUA Implementation Cost of Land Use Policies per Unit Area[Land Use Policy] = GET DIRECT CONSTANTS(
                'InputData/land/ICoLUPpUA/ICoLUPpUA.csv', ',', 'B2*')
	~	$/ acre
	~		|

Initial Available Land Areas[Land Use Policy] = 5.1102e+07, 1.36495e+09, 2.32492e+08, 
        8.19136e+07, 3.56156e+07, 2.96138e+08
	~	acres
	~		|

ISIC Code : ISIC 01T03,ISIC 05,ISIC 06,ISIC 07T08,ISIC 09,ISIC 10T12,ISIC 13T15,ISIC 16
        ,ISIC 17T18,ISIC 19,ISIC 20,ISIC 21,ISIC 22,ISIC 231,ISIC 239,ISIC 241,ISIC 242
        ,ISIC 25,ISIC 26,ISIC 27,ISIC 28,ISIC 29,ISIC 30,ISIC 31T33,ISIC 351,ISIC 352T353
        ,ISIC 36T39,ISIC 41T43,ISIC 45T47,ISIC 49T53,ISIC 55T56,ISIC 58T60,ISIC 61,ISIC 62T63
        ,ISIC 64T66,ISIC 68,ISIC 69T82,ISIC 84,ISIC 85,ISIC 86T88,ISIC 90T96,ISIC 97T98
	~	
	~		|

Land Area Available for LULUCF[Land Use Policy] = INTEG( - Land Protection and Restoration Efforts[
             Land Use Policy] , Initial Available Land Areas[Land Use Policy] ) 
	~	acres
	~		|

Land Area Newly Affected by Policy[Land Use Policy] = PLANAbPiaSY Potential Land Area Newly Affected by Policy in a Single Year[
        Land Use Policy] / One Year * Fraction of Land Use Policy Achieved This Year by Policy[
             Land Use Policy] 
	~	acres / Year
	~		|

Land Area under LULUCF Policy[Land Use Policy] = INTEG( Land Protection and Restoration Efforts[
             Land Use Policy] , 0) 
	~	acres
	~		|

Land Protection and Restoration Efforts[Land Use Policy] = Fraction of Land Use Policy Achieved This Year by Policy[
        Land Use Policy] * Land Area Available for LULUCF[Land Use Policy] / One Year
             
	~	acres/years
	~		|

Land Use Policy : land forest set asides,land afforestation and reforestation,land forest management
        ,land avoid deforestation,land peatland restoration,land forest restoration
	~	
	~		|

Last Year Cumulative Total Land Area Affected by Policy[Land Use Policy] = INTEG( Land Area Newly Affected by Policy[
             Land Use Policy] , 0) 
	~	acres
	~		|

LULUCF Anthropogenic Pollutant Emissions[Pollutant] = BLAPE BAU LULUCF Anthropogenic Pollutant Emissions[
        Pollutant] + Change in LULUCF Emissions[Pollutant] 
	~	g pollutant
	~		|

LULUCF Change in Nonenergy Expenditures by Entity[Cash Flow Entity] = Change in Forest Expenses by Entity[
        Cash Flow Entity] 
	~	$
	~		|

LULUCF Change in Nonenergy Industry Expenditures by ISIC Code[ISIC Code] :EXCEPT: [ISIC 01T03
] = 0 ~~|
LULUCF Change in Nonenergy Industry Expenditures by ISIC Code[ISIC 01T03] = LULUCF Change in Nonenergy Expenditures by Entity[
        nonenergy industries] 
	~	$
	~		|

LULUCF Change in Nonenergy Industry Revenue by ISIC Code[ISIC Code] :EXCEPT: [ISIC 01T03
] = 0 ~~|
LULUCF Change in Nonenergy Industry Revenue by ISIC Code[ISIC 01T03] = SUM ( Change in Forest Expenses by Entity[
             Cash Flow Entity!] ) 
	~	$
	~		|

LULUCF Change in Revenue by Entity[Cash Flow Entity] :EXCEPT: [nonenergy industries] = 
        0 ~~|
LULUCF Change in Revenue by Entity[nonenergy industries] = SUM ( LULUCF Change in Nonenergy Industry Revenue by ISIC Code[
             ISIC Code!] ) 
	~	$
	~		|

One Year = 1
	~	years
	~	This variable exists to avoid Vensim unit check errors when there is no \
		actual problem with the model.
	|

PLANAbPiaSY Potential Land Area Newly Affected by Policy in a Single Year[Land Use Policy
] := GET DIRECT DATA('InputData/land/PLANAbPiaSY/PLANAbPiaSY.csv', ',', '1', 'B2')
	~	acres
	~		|

Pollutant : CO2,VOC,CO,NOx,PM10,PM25,SOx,BC,OC,CH4,N2O,F gases
	~	
	~		|

RPEpUACE Rebound Pollutant Emissions per Unit Avoided CO2 Emissions[Pollutant] = GET DIRECT CONSTANTS(
                'InputData/land/RPEpUACE/RPEpUACE.csv', ',', 'B2*')
	~	Dmnl
	~		|

tfChange in LULUCF Emissions[Pollutant] :EXCEPT: [CO2] = SUM ( tfCO2 Abated by Land Use Policy This Year[
             Land Use Policy!] ) * RPEpUACE Rebound Pollutant Emissions per Unit Avoided CO2 Emissions[
             Pollutant]  ~~|
tfChange in LULUCF Emissions[CO2] = - SUM ( tfCO2 Abated by Land Use Policy This Year[
             Land Use Policy!] ) 
	~	g pollutant
	~		|

tfCO2 Abated by Improved Forest Management This Year = Land Protection and Restoration Efforts[
        land forest management] * One Year * CApULAbIFM CO2 Abated per Unit Land Area by Improved Forest Management
             
	~	g pollutant
	~		|

tfCO2 Abated by Land Use Policy This Year[Land Use Policy] :EXCEPT: [land forest management
] = Land Area under LULUCF Policy[Land Use Policy] * CSpULApYbP CO2 Sequestered per Unit Land Area per Year by Policy[
             Land Use Policy]  ~~|
tfCO2 Abated by Land Use Policy This Year[land forest management] = tfCO2 Abated by Improved Forest Management This Year
        
	~	g pollutant
	~		|

tfLULUCF Anthropogenic Pollutant Emissions[Pollutant] = BLAPE BAU LULUCF Anthropogenic Pollutant Emissions[
        Pollutant] + tfChange in LULUCF Emissions[Pollutant] 
	~	g pollutant
	~		~	:SUPPLEMENTARY 
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME = GET DIRECT CONSTANTS('InputData/plcy-schd/FT/FT.csv', ',', 'B2*')
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME = GET DIRECT CONSTANTS('InputData/plcy-schd/IT/IT.csv', ',', 'B2*')
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER = TIME STEP 
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

